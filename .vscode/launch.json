{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build debug",
      "type": "shell",
      "command": "C:/raylib/w64devkit/bin/gcc.exe",
      "args": [
        "-g",
        "${workspaceFolder}/src/main.c",
        "-o",
        "${workspaceFolder}/src/main.exe",
        "-IC:/raylib/raylib/src",
        "-LC:/raylib/raylib/src",
        "-lraylib",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:/raylib/w64devkit/bin;${env:PATH}" }
      },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build release",
      "type": "shell",
      "command": "C:/raylib/w64devkit/bin/gcc.exe",
      "args": [
        "-O2",
        "${workspaceFolder}/src/main.c",
        "-o",
        "${workspaceFolder}/src/main.exe",
        "-IC:/raylib/raylib/src",
        "-LC:/raylib/raylib/src",
        "-lraylib",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "C:/raylib/w64devkit/bin;${env:PATH}" }
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}